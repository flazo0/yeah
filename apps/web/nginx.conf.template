server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # The dashboard only answers under this random per-install path (PANEL_PATH, generated by
    # install.sh — see docker-compose.prod.yml) instead of "/". Anything else gets nothing back
    # at all (not even a valid HTTP response) — a port scanner or curious visitor can't tell
    # there's a web app here, let alone that it's yeah. Note there's no leading-slash-only
    # default: install.sh always generates a real random path, so PANEL_PATH is never just "/".
    location = ${PANEL_PATH} {
        return 301 ${PANEL_PATH}/;
    }

    # Reverse-proxies api/ws into the same origin as the dashboard, so only this one port needs
    # to be reachable from the internet — api/ws stay bound to 127.0.0.1 on the host (see
    # docker-compose.prod.yml) and are only reachable through here. This also means the frontend
    # never needs to know its own public host/IP at build time (see lib/api.ts, lib/ws.ts).
    location ${PANEL_PATH}/api/ {
        proxy_pass http://api:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ${PANEL_PATH}/ws {
        proxy_pass http://ws:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
    }

    location ${PANEL_PATH}/assets/ {
        alias /usr/share/nginx/html/assets/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Vite's `base` (see vite.config.ts) bakes this same prefix into every asset URL and into the
    # router (Vue Router's history base) — `alias` here strips it back off to reach the real files,
    # since the built dist/ has no such subdirectory on disk. Vue Router uses history mode — any
    # path under the prefix that isn't a real static file falls back to index.html.
    location ${PANEL_PATH}/ {
        alias /usr/share/nginx/html/;
        try_files $uri $uri/ ${PANEL_PATH}/index.html;
        index index.html;
    }

    location / {
        return 444;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
