# Postgres
DATABASE_URL=postgres://yeah:yeah@localhost:5432/yeah_dev

# Redis (BullMQ + pub/sub)
REDIS_URL=redis://localhost:6379

# Sessions
SESSION_SECRET=change-me-in-production

# Ports
API_PORT=3000
WS_PORT=3001

# Comma-separated origins allowed to call the API with credentials (Vite's dev port)
WEB_ORIGIN=http://localhost:5173,http://localhost:5174

# Used by apps/web (Vite) to reach api/ws in dev
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3001

# GitHub App (opcional — sem isso a tela "GitHub" só avisa que não está configurado).
# Crie um App em https://github.com/settings/apps/new:
#   Homepage URL:      a URL da sua instância (ex: https://seu-dominio.com)
#   Callback URL:      <VITE_API_URL>/github/callback
#   Setup URL:         mesma coisa, com "Redirect on update" marcado
#   Webhook URL:        <VITE_API_URL>/webhooks/github
#   Webhook secret:     gere um valor aleatório — é o GITHUB_APP_WEBHOOK_SECRET abaixo
#   Permissions:        Repository → Contents (Read-only), Metadata (Read-only)
#   Subscribe to events: Push
# Depois de criar, gere uma chave privada na própria página do App (baixa um .pem).
# GITHUB_APP_PRIVATE_KEY_BASE64 é esse .pem em base64 numa linha só: base64 -w0 sua-chave.pem
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=
