# Postgres
DATABASE_URL=postgres://yeah:yeah@localhost:5432/yeah_dev

# Redis (BullMQ + pub/sub)
REDIS_URL=redis://localhost:6379

# Sessions
SESSION_SECRET=change-me-in-production

# At-rest encryption of the secrets stored in the database (AES-256-GCM). Required in production; in dev,
# without it, a fixed built-in key is used (only good for dev). Losing the key = losing the stored secrets.
# ENCRYPTION_KEY_PREVIOUS accepts old keys (comma-separated) for rotation; after rotating run "db:rekey" (see docs/architecture.md).
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

# Ports
API_PORT=3000
WS_PORT=3001

# Comma-separated origins allowed to call the API with credentials (Vite's dev port)
WEB_ORIGIN=http://localhost:5173,http://localhost:5174

# Used by apps/web (Vite) to reach api/ws in dev
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3001

# GitHub App (optional — without it the "GitHub" page just says it is not configured).
# Create an App at https://github.com/settings/apps/new:
#   Homepage URL:      your instance URL (e.g. https://your-domain.com)
#   Callback URL:      <VITE_API_URL>/github/callback
#   Setup URL:         same thing, with "Redirect on update" checked
#   Webhook URL:        <VITE_API_URL>/webhooks/github
#   Webhook secret:     generate a random value — it is GITHUB_APP_WEBHOOK_SECRET below
#   Permissions:        Repository → Contents (Read-only), Metadata (Read-only)
#   Subscribe to events: Push
# After creating it, generate a private key on the App's own page (downloads a .pem).
# GITHUB_APP_PRIVATE_KEY_BASE64 is that .pem in base64 on a single line: base64 -w0 your-key.pem
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=

# Days until the worker clears the text log of finished deployments/backups/tasks/cleanups/updates —
# the history (status, size, dates) stays, only the log text goes away. 0 disables it.
LOG_RETENTION_DAYS=90

# Container file browser: reading is always on; editing, uploading, creating folders and deleting are OFF
# unless this is true (see docs/security.md). Upload cap in whole megabytes (1-100, default 10).
# FILE_BROWSER_WRITES=false
# FILE_BROWSER_UPLOAD_MAX_MB=10

# Maximum Postgres connection pool size per process (api, worker). Empty = Bun's default.
# DB_POOL_MAX=

# Server metrics collection interval, in seconds (default 60, minimum 15). Raise it to save CPU/SSH.
# METRICS_INTERVAL_SECONDS=60

# Process logs (api/worker/ws): json (one JSON line per event, default) or text; minimum level debug|info|warn|error.
# LOG_FORMAT=json
# LOG_LEVEL=info
